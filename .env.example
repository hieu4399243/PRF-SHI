# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# Kết nối Postgres của Supabase (Project → Settings → Database → Connection string).
# Khuyên dùng "Connection pooler" / chế độ Transaction (cổng 6543).
# Bỏ trống / xóa dòng này -> app tự dùng file JSON (local), không cần DB.
DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Khóa bí mật cho Flask session (production nên đặt chuỗi ngẫu nhiên).
SECRET_KEY=doi-thanh-mot-chuoi-ngau-nhien

# --- Authentication (JWT + Password) ---
# SECRET_KEY cũng dùng làm JWT secret key
# JWT_EXPIRATION_HOURS: thời hạn token (mặc định 24)
JWT_EXPIRATION_HOURS=24
# Đặt true nếu chạy trên HTTPS (production)
SECURE_COOKIE=false

# --- LLM (OpenRouter) ---
# Lấy key tại https://openrouter.ai/keys (dạng sk-or-v1-...).
# CÓ key  -> triage dùng LLM (hiểu ngữ nghĩa câu tiếng Việt).
# KHÔNG có -> tự động chạy rule-based v2, dự án vẫn hoạt động đầy đủ.
OPENROUTER_API_KEY=
# Model trên OpenRouter. Đổi model chỉ cần sửa dòng này.
LLM_MODEL=google/gemini-2.5-flash-lite
# Đặt LLM_ENABLED=0 để tắt LLM dù có key (test/offline). LLM_TIMEOUT: giây.
LLM_ENABLED=1
LLM_TIMEOUT=8
# Chatbot dùng LLM VIẾT CÂU TRẢ LỜI ở các nhánh bộ luật không hiểu (mặc định bật
# khi có key). Đặt =0 để chatbot chỉ đọc template cứng như trước.
CHAT_LLM_REPLY=1
